#!/usr/bin/env bash

#set -e

declare -A COLORS
COLORS[CYAN]="\033[1;96m"
COLORS[RED]="\033[0;91m"
COLORS[GREEN]="\033[0;92m"
RESET='\033[0m'

swap() {
    local -n array_swap=$1
    local first=$2
    local second=$3
    local tmp="${array_swap[first]}"
    array_swap[first]="${array_swap[second]}"
    array_swap[second]="$tmp"
}

reverse() {
    local -n array_reverse=$1
    local array_reverse_len=${#array_reverse[@]}
    local first=${2:-0}
    local last=${3:-$array_reverse_len}

    while ((first < --last)); do
       swap array_reverse $first $last
       ((++first))
    done
}

rotate() {
    local -n array_rotate=$1
    local array_rotate_len="${#array_rotate[@]}"
    local first=${2:-0}
    local middle=${3:-0}
    local last=${4:-0}
    if [[ $middle -gt $first && $middle -lt $last ]]; then
       reverse array_rotate $first $middle
       reverse array_rotate $middle $last
       reverse array_rotate $first $last
    fi
}

declare -a COLOR=( CYAN RED GREEN )
next_color() {
	rotate COLOR 0 1 ${#COLOR[@]}
	echo "${COLOR[0]}"
}

cleanup() {
	rm "$EVENTS"
	printf '\033[?1000l\033[?1006l'
	tput cnorm
	tput rmcup
	stty sane
	exit
}

