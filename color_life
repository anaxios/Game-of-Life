sub clear() {
	print "\e[H\e[2J\e[3J";
}

sub hide_cursor() {
	print "\e[?25l";
}

sub show_cursor() {
	print "\e[?25h";
}

sub enter_altscreen() {
	printf "\e[?1049h";
}

sub leave_altscreen() {
	printf "\e[?1049l";
}

our $rand_seed = 8675309;
sub rand_next() {
	my $x = $rand_seed;
	my $mask = 0xFFFFFFFFFFFFFFFF;
	$x = ($x +^ ($x +< 21) +& $mask);
	$x = ($x +^ (($x +> 35) +& 0x1FFFFFFF) +& $mask);
	$x = ($x +^ ($x +< 4) +& $mask);
	#$rand_seed = $x +& 0x7FFFFFFFFFFFFFFF;
	$rand_seed = $x;
	return $x;

}

sub init_board(@board) {
	loop (my $y = 0; $y < @board.shape[1]; ++$y) {
		loop (my $x = 0; $x < @board.shape[0]; ++$x) {
			#local color=GREEN
			my $r = rand_next();
			@board[$x;$y] = (($r +> 32) % 8) == 0 ?? 1 !! 0;
			#@board[$x;$y] = 1;
		}
	}
	clear();
}

sub draw_board(@last_board, @board) {
	my $frame = "\e[H";
	loop (my $y = 0; $y < @board.shape[1]; ++$y) {
		loop (my $x = 0; $x < @board.shape[0]; ++$x) {
			if @board[$x;$y] == 1 && @last_board[$x;$y] == 0 -> {
				$frame ~= "\e[{$y + 1};{$x + 1}H{$ameba}";
			}
			if @board[$x;$y] == 0 && @last_board[$x;$y] == 1 -> {
				$frame ~= "\e[{$y + 1};{$x + 1}H ";
			}
		}
	}
	$*OUT.write($frame.encode);
}

sub life(@last_board, @board) {
	loop (my $y = 0; $y < @board.shape[1]; ++$y) {
		loop (my $x = 0; $x < @board.shape[0]; ++$x) {
			my $colums = @board.shape[0];
			my $lines = @board.shape[1];
			my $count = 0;

			# check back & front
			my $back = ($x - 1) % $colums;
			my $forward = ($x + 1) % $colums;
			for (@last_board[$back;$y]),
				(@last_board[$forward;$y]) -> $i {
				++$count if $i == 1;
			}

			my $up = ($y - 1) % $lines;
			my $down = ($y + 1) % $lines;

			# check above
			for (@last_board[$back;$up]),
				(@last_board[$x;$up]),
				(@last_board[$forward;$up]) -> $i {
				++$count if $i == 1;
			}

			# check below
			for (@last_board[$back;$down]),
				(@last_board[$x;$down]),
				(@last_board[$forward;$down]) -> $i {
				++$count if $i == 1;
			}

			my $is_alive = @last_board[$x;$y] == 1;

			if ! $is_alive && $count == 3 -> {
				@board[$x;$y] = 1;
			} elsif $is_alive && $count == 2 || $count == 3 -> {
				@board[$x;$y] = 1;
			} else {
				@board[$x;$y] = 0;
			}
		}
	}
}

sub main() {
	my ($lines, $columns) = words(run('stty', 'size', :out).out.slurp);
	my @last_board[$columns;$lines];
	my @board[$columns;$lines];
	init_board(@last_board);
	#enter_altscreen();
	#hide_cursor();

	loop {
		life(@last_board, @board);
		draw_board(@last_board, @board);

		my @tmp_board := @last_board;
		@last_board := @board;
		@board := @tmp_board;

	}

	LEAVE {
		#leave_altscreen();
		#show_cursor();
	}
}
main();

