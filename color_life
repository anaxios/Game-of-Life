EVENTS="/tmp/color_life_evens.fifo"

trap 'cleanup' INT TERM EXIT
main() {
	local lines columns
	read -r lines columns < <(stty size)
	declare -a screen_buffer=()
	declare -a prev_screen_buffer=()

	if  ! [[ -p "$EVENTS" ]]; then
		mkfifo "$EVENTS"
	fi

	lines=10
	columns=10


	tput clear
	tput civis
	tput smcup
	#stty -echo -icanon

	# Enable SGR mouse tracking and alternate screen
	#printf '\033[?1006h\033[?1000h'

	# init board
	for ((y = 0; y < lines; ++y)); do
		for ((x = 0; x < columns; ++x)); do
			local color=GREEN
			if [[ $(($RANDOM % 8)) == 0 ]]; then
				screen_buffer[(y * columns) + x]="${COLORS[$color]}#${RESET}"
			else
				screen_buffer[(y * columns) + x]=" "
			fi
		done
	done

	local stride=$columns

	while true; do
		for ((y = 0; y < lines; ++y)); do
			for ((x = 0; x < columns; ++x)); do
				local color=${COLOR[$RANDOM % 3]}

				local yu=$(( (y - 1 < 0) ? (y - 1 + stride) % stride : (y - 1) ))
				local yd=$(( (y + 1) % stride ))
				local xb=$(( (x - 1 < 0) ? (x - 1 + lines) % lines : (x - 1) ))
				local xf=$(( (x + 1) % lines ))
				local u=$(( (yu * stride) + x ))
				local ub=$(( (yu * stride) + xb ))
				local uf=$(( (yu * stride) + xf ))
				local d=$(( (yd * stride) + x ))
				local db=$(( (yd * stride) + xb ))
				local df=$(( (yd * stride) + xf ))
				local f=$(( xf ))
				local b=$(( xb ))

				screen_buffer[(y * columns) + x]="${COLORS[$color]}#${RESET}"
				echo "size: $((columns * lines))" >/dev/ttys009
				echo "ub: $ub" " u: $u" "uf: $uf" >/dev/ttys009
				echo " b: $b" " m: $((y * columns + x))" "f: $f" >/dev/ttys009
				echo "db: $db" " d: $d" "df: $df" >/dev/ttys009
				sleep 0.1
			done
		done

		(IFS= ; printf "${screen_buffer[*]}")
		#next_color 1>/dev/null
		prev_screen_buffer=( "${screen_buffer[@]}" )
	done


}; main "$@"
